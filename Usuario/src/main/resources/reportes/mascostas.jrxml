<?xml version="1.0" encoding="UTF-8"?>
<jasperReport name="mascotas.jrxml"
    pageWidth="595"
    pageHeight="842"
    columnWidth="555"
    leftMargin="20"
    rightMargin="20"
    topMargin="20"
    bottomMargin="20">

    <queryString>
        <![CDATA[
        SELECT
            m.id,
            m.nombre,
            m.especie,
            m.raza,
            m.edad,
            c.nombre AS cliente
        FROM mascota m
        INNER JOIN cliente c
        ON m.id_cliente = c.id
        ]]>
    </queryString>

    <field name="id" class="java.lang.Integer"/>
    <field name="nombre" class="java.lang.String"/>
    <field name="especie" class="java.lang.String"/>
    <field name="raza" class="java.lang.String"/>
    <field name="edad" class="java.lang.Integer"/>
    <field name="cliente" class="java.lang.String"/>

    <title>
        <band height="40">
            <staticText>
                <reportElement x="150" y="10" width="250" height="30"/>
                <text><![CDATA[REPORTE DE MASCOTAS]]></text>
            </staticText>
        </band>
    </title>

    <columnHeader>
        <band height="25">

            <staticText>
                <reportElement x="0" y="0" width="40" height="20"/>
                <text><![CDATA[ID]]></text>
            </staticText>

            <staticText>
                <reportElement x="50" y="0" width="90" height="20"/>
                <text><![CDATA[Nombre]]></text>
            </staticText>

            <staticText>
                <reportElement x="150" y="0" width="80" height="20"/>
                <text><![CDATA[Especie]]></text>
            </staticText>

            <staticText>
                <reportElement x="240" y="0" width="80" height="20"/>
                <text><![CDATA[Raza]]></text>
            </staticText>

            <staticText>
                <reportElement x="330" y="0" width="50" height="20"/>
                <text><![CDATA[Edad]]></text>
            </staticText>

            <staticText>
                <reportElement x="390" y="0" width="150" height="20"/>
                <text><![CDATA[Cliente]]></text>
            </staticText>

        </band>
    </columnHeader>

    <detail>
        <band height="20">

            <textField>
                <reportElement x="0" y="0" width="40" height="20"/>
                <textFieldExpression><![CDATA[$F{id}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="50" y="0" width="90" height="20"/>
                <textFieldExpression><![CDATA[$F{nombre}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="150" y="0" width="80" height="20"/>
                <textFieldExpression><![CDATA[$F{especie}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="240" y="0" width="80" height="20"/>
                <textFieldExpression><![CDATA[$F{raza}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="330" y="0" width="50" height="20"/>
                <textFieldExpression><![CDATA[$F{edad}]]></textFieldExpression>
            </textField>

            <textField>
                <reportElement x="390" y="0" width="150" height="20"/>
                <textFieldExpression><![CDATA[$F{cliente}]]></textFieldExpression>
            </textField>

        </band>
    </detail>

</jasperReport>